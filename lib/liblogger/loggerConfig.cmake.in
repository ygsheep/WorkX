@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(SDL3)

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/deartsdl_loggerTargets.cmake")

# Set variables
set(deartsdl_logger_VERSION @PROJECT_VERSION@)
set(deartsdl_logger_FOUND TRUE)

# Check components
set(deartsdl_logger_LIBRARIES deartsdl_logger::deartsdl_logger)
set(deartsdl_logger_INCLUDE_DIRS "@PACKAGE_INSTALL_INCLUDE_DIR@")