@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/logger_targets.cmake")

# Set variables
set(logger_VERSION @PROJECT_VERSION@)
set(logger_FOUND TRUE)

# Check components
set(logger_LIBRARIES logger)
set(logger_INCLUDE_DIRS "@PACKAGE_INSTALL_INCLUDE_DIR@")
