@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 依赖查找（公共头暴露的硬依赖）
find_dependency(nlohmann_json CONFIG)
find_dependency(CURL)
find_dependency(logger CONFIG)

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/workxTargets.cmake")

# 顶层变量
set(workx_VERSION "@PROJECT_VERSION@")
set(workx_FOUND TRUE)
set(workx_LIBRARIES workx::workx_agent workx::workx_core)

check_required_components(workx)
