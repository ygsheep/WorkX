# Build output directories
build/
build-wsl/
build_Linux/
_build/
vcpkg_installed/
.vcpkg/

example/cc/
example/DeepSeek-Reasonix/

# IDE and editor directories
.idea/
.trae/
.vscode/

# Build artifacts
*.exe
*.lib
*.pdb
*.obj
*.o
*.out
*.dll
*.a

# CMake generated files
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt

# Visual Studio
.vs/
*.user

# Build logs and temp files
*.log
*.tmp
*.bak
*.swp
.DS_Store

# Configuration files (may contain user-specific settings)
workx_session.json
config.json
*.env

# Runtime-generated history file (created by Terminal in home dir)
.workx_history

# models.dev catalog data (large local test fixtures, ~17MB)
models-*.json

# Test outputs
tests/*.log
tests/*.out

# Vendor external binaries (downloaded by scripts/fetch-ripgrep.py)
vendor/ripgrep/

# Generated icon artifacts (from src/icon.png via scripts/convert_icon.py)
# 源图 src/icon.png 入库，产物 ico/icns 由 CMake 配置阶段生成
src/icon.ico
src/icon.icns

# Transient artifacts (script/tooling leftovers)
# fetch_ts_grammars.py 抓取 wiki 的临时缓存
/_wiki_parsers.md
# Python 脚本缓存（gen/fetch_ts_grammars.py 等）
__pycache__/
# worktree/脚本验证残留目录
/.claude/tmp/
# 误拉取的 grammar submodule 残留（项目示例目录是单数 example/，此处为复数根目录残留）
/examples/

# 发布打包产物（scripts/package_release.py 输出）
/dist/
